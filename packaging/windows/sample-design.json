{
  "steps": [
    { "op": "log", "text": "CAD360 sample design: mounting plate" },
    { "op": "wait", "frames": 20 },
    { "op": "select_plane", "plane": "XY" },
    { "op": "cmd", "id": "CreateSketch" },
    { "op": "cmd", "id": "Rectangle2Pt" },
    { "op": "sketch_click", "at": [0, 0] },
    { "op": "sketch_click", "at": [80, 50] },
    { "op": "key", "key": "Escape" },
    { "op": "cmd", "id": "SketchDimension" },
    { "op": "sketch_click", "at": [40, 0] },
    { "op": "sketch_click", "at": [40, -8] },
    { "op": "sketch_value", "text": "80 mm" },
    { "op": "sketch_click", "at": [80, 25] },
    { "op": "sketch_click", "at": [88, 25] },
    { "op": "sketch_value", "text": "50 mm" },
    { "op": "key", "key": "Escape" },
    { "op": "cmd", "id": "FinishSketch" },

    { "op": "select_profile", "sketch": 0, "profile": 0 },
    { "op": "cmd", "id": "Extrude" },
    { "op": "set_dialog_param", "expr": "8 mm" },
    { "op": "dialog_ok" },

    { "op": "select_edges", "axis": "z" },
    { "op": "cmd", "id": "Fillet" },
    { "op": "set_dialog_param", "expr": "6 mm" },
    { "op": "dialog_ok" },

    { "op": "select_face", "normal": [0, 0, 1] },
    { "op": "cmd", "id": "CreateSketch" },
    { "op": "cmd", "id": "Slot" },
    { "op": "sketch_click", "at": [25, 25] },
    { "op": "sketch_click", "at": [55, 25] },
    { "op": "sketch_click", "at": [40, 31] },
    { "op": "key", "key": "Escape" },
    { "op": "cmd", "id": "FinishSketch" },
    { "op": "select_profile", "sketch": 1, "profile": 1 },
    { "op": "cmd", "id": "Extrude" },
    { "op": "extrude_options", "operation": "Cut", "direction": "Reverse", "through_all": true },
    { "op": "dialog_ok" },
    { "op": "clear_selection" },
    { "op": "view", "view": "Home" },
    { "op": "fit" },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "sample-mounting-plate" },
    { "op": "save", "path": "samples/mounting-plate.c360" },
    { "op": "close" }
  ]
}
