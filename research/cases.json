{
  "about": "Shared case catalogue for differential testing. Units: mm and degrees. Every kernel (cad-geom Rust, OCCT via cad-kernel/opencascade, ASM via the Fusion TemporaryBRepManager probe) builds exactly these inputs. Box: corner + size (axis-aligned). Cylinder/cone: base centre, axis direction, base radius r0, top radius r1, height h. Sphere: centre, r. Torus: centre, axis, major, minor. Boolean: op in {union, cut, intersect}; 'tools' are applied in order to 'target'.",
  "version": 1,
  "cases": [
    { "id": "prim.box",            "kind": "box",      "corner": [0,0,0], "size": [50,30,10] },
    { "id": "prim.box.tiny",       "kind": "box",      "corner": [0,0,0], "size": [0.01,0.02,0.03] },
    { "id": "prim.box.huge",       "kind": "box",      "corner": [0,0,0], "size": [100000,50000,20000] },
    { "id": "prim.cylinder",       "kind": "cylinder", "base": [0,0,0], "axis": [0,0,1], "r0": 10, "r1": 10, "h": 20 },
    { "id": "prim.cylinder.tilted","kind": "cylinder", "base": [1,2,3], "axis": [1,1,1], "r0": 4, "r1": 4, "h": 15 },
    { "id": "prim.cone",           "kind": "cone",     "base": [0,0,0], "axis": [0,0,1], "r0": 10, "r1": 0, "h": 20 },
    { "id": "prim.frustum",        "kind": "cone",     "base": [0,0,0], "axis": [0,0,1], "r0": 10, "r1": 5, "h": 20 },
    { "id": "prim.sphere",         "kind": "sphere",   "center": [0,0,0], "r": 10 },
    { "id": "prim.torus",          "kind": "torus",    "center": [0,0,0], "axis": [0,0,1], "major": 20, "minor": 5 },

    { "id": "bool.union.overlap", "kind": "boolean", "op": "union",
      "target": { "kind": "box", "corner": [0,0,0], "size": [20,20,20] },
      "tools": [ { "kind": "box", "corner": [10,10,10], "size": [20,20,20] } ] },
    { "id": "bool.cut.hole", "kind": "boolean", "op": "cut",
      "target": { "kind": "box", "corner": [0,0,0], "size": [50,30,10] },
      "tools": [ { "kind": "cylinder", "base": [25,15,-5], "axis": [0,0,1], "r0": 6, "r1": 6, "h": 20 } ] },
    { "id": "bool.union.coincident_face", "kind": "boolean", "op": "union",
      "target": { "kind": "box", "corner": [0,0,0], "size": [20,20,20] },
      "tools": [ { "kind": "box", "corner": [20,0,0], "size": [20,20,20] } ] },
    { "id": "bool.union.coincident_partial", "kind": "boolean", "op": "union",
      "target": { "kind": "box", "corner": [0,0,0], "size": [20,20,20] },
      "tools": [ { "kind": "box", "corner": [20,5,5], "size": [20,10,10] } ] },
    { "id": "bool.cut.coplanar_through", "kind": "boolean", "op": "cut",
      "target": { "kind": "box", "corner": [0,0,0], "size": [20,20,20] },
      "tools": [ { "kind": "box", "corner": [5,5,0], "size": [10,10,20] } ] },
    { "id": "bool.union.tangent_cylinder", "kind": "boolean", "op": "union",
      "target": { "kind": "box", "corner": [0,0,0], "size": [20,20,20] },
      "tools": [ { "kind": "cylinder", "base": [30,10,0], "axis": [0,0,1], "r0": 10, "r1": 10, "h": 20 } ] },
    { "id": "bool.union.near_tangent_cylinder", "kind": "boolean", "op": "union",
      "target": { "kind": "box", "corner": [0,0,0], "size": [20,20,20] },
      "tools": [ { "kind": "cylinder", "base": [29.99999,10,0], "axis": [0,0,1], "r0": 10, "r1": 10, "h": 20 } ] },
    { "id": "bool.intersect.box_sphere", "kind": "boolean", "op": "intersect",
      "target": { "kind": "box", "corner": [-10,-10,-10], "size": [20,20,20] },
      "tools": [ { "kind": "sphere", "center": [0,0,0], "r": 12 } ] },
    { "id": "bool.cut.disjoint", "kind": "boolean", "op": "cut",
      "target": { "kind": "box", "corner": [0,0,0], "size": [10,10,10] },
      "tools": [ { "kind": "box", "corner": [20,20,20], "size": [5,5,5] } ] },
    { "id": "bool.union.repeated", "kind": "boolean", "op": "union",
      "target": { "kind": "box", "corner": [0,0,0], "size": [40,10,10] },
      "tools": [
        { "kind": "box", "corner": [2,2,10],  "size": [4,4,4] },
        { "kind": "box", "corner": [10,2,10], "size": [4,4,4] },
        { "kind": "box", "corner": [18,2,10], "size": [4,4,4] },
        { "kind": "box", "corner": [26,2,10], "size": [4,4,4] },
        { "kind": "box", "corner": [34,2,10], "size": [4,4,4] } ] }
  ]
}
