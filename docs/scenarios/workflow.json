{
  "steps": [
    { "op": "wait", "frames": 40 },
    { "op": "screenshot", "name": "01_new_design" },

    { "op": "cmd", "id": "CreateSketch" },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "02_create_sketch_select_plane" },
    { "op": "select_plane", "plane": "XY" },
    { "op": "cmd", "id": "CreateSketch" },
    { "op": "wait", "frames": 15 },
    { "op": "screenshot", "name": "03_sketch_mode" },

    { "op": "cmd", "id": "Rectangle2Pt" },
    { "op": "sketch_click", "at": [0, 0] },
    { "op": "sketch_click", "at": [50, 30] },
    { "op": "key", "key": "Escape" },
    { "op": "cmd", "id": "SketchDimension" },
    { "op": "sketch_click", "at": [25, 0] },
    { "op": "sketch_click", "at": [25, -8] },
    { "op": "sketch_value", "text": "50 mm" },
    { "op": "sketch_click", "at": [50, 15] },
    { "op": "sketch_click", "at": [58, 15] },
    { "op": "sketch_value", "text": "30 mm" },
    { "op": "key", "key": "Escape" },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "04_sketch_rectangle_dimensioned" },
    { "op": "cmd", "id": "FinishSketch" },

    { "op": "view", "view": "Home" },
    { "op": "select_profile", "sketch": 0, "profile": 0 },
    { "op": "cmd", "id": "Extrude" },
    { "op": "set_dialog_param", "expr": "10 mm" },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "05_extrude_dialog" },
    { "op": "dialog_ok" },
    { "op": "fit" },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "06_extruded_box" },

    { "op": "set_param", "name": "d3", "expr": "20 mm" },
    { "op": "set_param", "name": "d1", "expr": "60 mm" },
    { "op": "fit" },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "07_after_parameter_edits" },

    { "op": "select_edges", "axis": "z" },
    { "op": "cmd", "id": "Fillet" },
    { "op": "set_dialog_param", "expr": "5 mm" },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "08_fillet_dialog" },
    { "op": "dialog_ok" },

    { "op": "select_face", "normal": [0, 0, 1] },
    { "op": "cmd", "id": "CreateSketch" },
    { "op": "cmd", "id": "CircleCenter" },
    { "op": "sketch_click", "at": [35, 15] },
    { "op": "sketch_click", "at": [41, 15] },
    { "op": "key", "key": "Escape" },
    { "op": "cmd", "id": "FinishSketch" },
    { "op": "view", "view": "Home" },
    { "op": "select_profile", "sketch": 1, "profile": 1 },
    { "op": "cmd", "id": "Extrude" },
    { "op": "extrude_options", "operation": "Cut", "direction": "Reverse", "through_all": true },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "09_cut_dialog" },
    { "op": "dialog_ok" },
    { "op": "clear_selection" },
    { "op": "fit" },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "10_final_model" },

    { "op": "cmd", "id": "ChangeParameters" },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "11_change_parameters" },
    { "op": "dialog_cancel" },

    { "op": "marker", "index": 2 },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "12_timeline_rolled_back" },
    { "op": "marker", "index": 5 },

    { "op": "cmd", "id": "SectionAnalysis" },
    { "op": "orbit", "dx": -230, "dy": 0 },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "13_section_analysis" },
    { "op": "orbit", "dx": 170, "dy": 0 },
    { "op": "cmd", "id": "SectionAnalysis" },

    { "op": "save", "path": "C:/c360t/scenario/workflow.c360" },
    { "op": "export_step", "path": "C:/c360t/scenario/workflow.step" },
    { "op": "export_stl", "path": "C:/c360t/scenario/workflow.stl" },
    { "op": "open", "path": "C:/c360t/scenario/workflow.c360" },
    { "op": "wait", "frames": 15 },
    { "op": "screenshot", "name": "14_reopened" },
    { "op": "close" }
  ]
}
