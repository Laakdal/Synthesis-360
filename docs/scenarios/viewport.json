{
  "steps": [
    { "op": "wait", "frames": 30 },
    { "op": "select_plane", "plane": "XY" },
    { "op": "cmd", "id": "CreateSketch" },
    { "op": "cmd", "id": "Rectangle2Pt" },
    { "op": "sketch_click", "at": [0, 0] },
    { "op": "sketch_click", "at": [50, 30] },
    { "op": "key", "key": "Escape" },
    { "op": "cmd", "id": "SketchDimension" },
    { "op": "sketch_click", "at": [25, 0] },
    { "op": "sketch_click", "at": [25, -8] },
    { "op": "sketch_value", "text": "50 mm" },
    { "op": "sketch_click", "at": [50, 15] },
    { "op": "sketch_click", "at": [58, 15] },
    { "op": "sketch_value", "text": "30 mm" },
    { "op": "key", "key": "Escape" },
    { "op": "cmd", "id": "FinishSketch" },

    { "op": "view", "view": "Home" },
    { "op": "select_profile", "sketch": 0, "profile": 0 },
    { "op": "cmd", "id": "Extrude" },
    { "op": "set_dialog_param", "expr": "10 mm" },
    { "op": "wait", "frames": 10 },
    { "op": "manip_press" },
    { "op": "manip_drag", "value": 18.2 },
    { "op": "wait", "frames": 4 },
    { "op": "manip_drag", "value": 25.3 },
    { "op": "wait", "frames": 12 },
    { "op": "screenshot", "name": "05b_extrude_manipulator" },
    { "op": "manip_release" },
    { "op": "wait", "frames": 6 },
    { "op": "screenshot", "name": "05c_extrude_manipulator_released" },
    { "op": "dialog_ok" },

    { "op": "select_edges", "axis": "z" },
    { "op": "cmd", "id": "Fillet" },
    { "op": "set_dialog_param", "expr": "3 mm" },
    { "op": "wait", "frames": 6 },
    { "op": "manip_press" },
    { "op": "manip_drag", "value": 6.4 },
    { "op": "wait", "frames": 8 },
    { "op": "screenshot", "name": "08b_fillet_manipulator" },
    { "op": "manip_release" },
    { "op": "wait", "frames": 6 },
    { "op": "screenshot", "name": "08c_fillet_manipulator_released" },
    { "op": "dialog_ok" },

    { "op": "cmd", "id": "SectionAnalysis" },
    { "op": "orbit", "dx": -230, "dy": 0 },
    { "op": "wait", "frames": 8 },
    { "op": "screenshot", "name": "13b_section_box" },
    { "op": "close" }
  ]
}
