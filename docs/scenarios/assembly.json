{
  "steps": [
    { "op": "wait", "frames": 30 },
    { "op": "select_plane", "plane": "XY" },
    { "op": "cmd", "id": "CreateSketch" },
    { "op": "cmd", "id": "Rectangle2Pt" },
    { "op": "sketch_click", "at": [0, 0] },
    { "op": "sketch_click", "at": [40, 40] },
    { "op": "key", "key": "Escape" },
    { "op": "cmd", "id": "FinishSketch" },
    { "op": "select_profile", "sketch": 0, "profile": 0 },
    { "op": "cmd", "id": "Extrude" },
    { "op": "set_dialog_param", "expr": "20 mm" },
    { "op": "dialog_ok" },

    { "op": "clear_selection" },
    { "op": "cmd", "id": "NewComponent" },
    { "op": "select_plane", "plane": "XY" },
    { "op": "cmd", "id": "CreateSketch" },
    { "op": "cmd", "id": "Rectangle2Pt" },
    { "op": "sketch_click", "at": [70, 0] },
    { "op": "sketch_click", "at": [100, 15] },
    { "op": "key", "key": "Escape" },
    { "op": "cmd", "id": "FinishSketch" },
    { "op": "select_profile", "sketch": 1, "profile": 0 },
    { "op": "cmd", "id": "Extrude" },
    { "op": "extrude_options", "operation": "New" },
    { "op": "set_dialog_param", "expr": "10 mm" },
    { "op": "dialog_ok" },
    { "op": "clear_selection" },
    { "op": "view", "view": "Home" },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "30_two_components" },

    { "op": "cmd", "id": "Joint" },
    { "op": "select_face", "normal": [0, 0, 1], "body": 0 },
    { "op": "select_face", "normal": [0, 0, -1], "body": 1 },
    { "op": "set_dialog_param", "expr": "30 deg" },
    { "op": "fit" },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "31_joint_dialog" },
    { "op": "dialog_ok" },
    { "op": "clear_selection" },
    { "op": "fit" },
    { "op": "wait", "frames": 10 },
    { "op": "screenshot", "name": "32_assembled" },
    { "op": "close" }
  ]
}
